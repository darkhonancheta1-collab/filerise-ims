# Fil-Rise IMS — environment configuration template
#
# Copy this file to ".env" in the same directory and fill in real values.
# ".env" is git-ignored and blocked from direct HTTP access by .htaccess —
# never commit it, never place real secrets in config.php or any other
# file that is tracked in git or bundled into deployment archives.
#
# The Groq API key, ElevenLabs API key, and Gmail credentials that were
# previously hardcoded in config.php must be treated as compromised and
# regenerated. Put the NEW values here, not in source code.

# --- Third-party AI / voice APIs ---
GROQ_API_KEY=
ELEVENLABS_API_KEY=

# --- Gmail SMTP (used to send password-reset codes) ---
# Generate an "App Password" at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Google account).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Fil-Rise IMS

# --- Database ---
# Use a dedicated, least-privilege MySQL account in staging/production —
# never "root" with an empty password outside local development.
DB_HOST=127.0.0.1
DB_NAME=filrise
DB_USER=root
DB_PASS=

# --- HTTPS enforcement ---
# Set to 1 only once the site is served over HTTPS with a valid
# certificate. Leave unset (or 0) for local HTTP development.
FORCE_HTTPS=0
